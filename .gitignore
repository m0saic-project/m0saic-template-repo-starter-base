# dependencies
node_modules

# build output — `npm run build` writes both. Hosts load dist/index.js (never
# src/), so build before adding this folder as a source. The full starter
# commits these for a zero-build clone; this scaffold is for developing in,
# so generated files stay out of your diffs.
dist
template-manifest.json

# local render output
test-output

# OS files
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
